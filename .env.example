# Read by docker-compose (auto-loaded from the same directory as
# docker-compose.yml). Separate from backend/.env, which holds app secrets
# (JWT, CORS, Cloudinary) shared between local `npm run dev` and the container.
#
# Setup: cp .env.example .env, then set a real password.
POSTGRES_USER=galaxyfood
POSTGRES_PASSWORD=
POSTGRES_DB=galaxyfood
