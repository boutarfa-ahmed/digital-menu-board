# --- Runtime ---
NODE_ENV=development
PORT=5000

# --- Database ---
# Postgres now (was SQLite). Two ways to run it locally:
#   1. `docker compose up -d postgres` from the repo root, then point this at
#      localhost (the container's 5432 is published to the host):
DATABASE_URL="postgresql://galaxyfood:CHANGE_ME@localhost:5432/galaxyfood"
#   2. Running the whole stack via `docker compose up`: leave this unset here,
#      docker-compose.yml injects the right value (hostname `postgres`, not
#      `localhost`) for the backend container.

# --- Auth (REQUIRED — the server refuses to boot without these) ---
# Generate each one separately: openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRES_IN=8h
REFRESH_TOKEN_EXPIRES_IN=30

# --- CORS ---
# Comma-separated allowlist. Leave empty in development (any origin is
# reflected, so Vite on any port works). REQUIRED in production.
# e.g. CORS_ORIGINS=https://admin.galaxyfood.ch,https://tv.galaxyfood.ch
# Running the full stack via `docker compose up` (Caddy + both frontends,
# see root Caddyfile): CORS_ORIGINS=https://admin.localhost,https://tv.localhost
CORS_ORIGINS=

# --- Cloudinary (image uploads) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Seed (npm run seed — REQUIRED, no default password) ---
SEED_ADMIN_EMAIL=ahmed@galaxy.com
SEED_ADMIN_PASSWORD=
# In production, `npm run seed` refuses to run against a non-empty database
# unless this is set — it deletes all menu/category/screen/theme data before
# recreating demo content. Only set it when you actually mean to wipe prod.
# SEED_FORCE=yes
