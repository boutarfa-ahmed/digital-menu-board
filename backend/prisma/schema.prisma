generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id     Int        @id @default(autoincrement())
  name   String     @unique   // "Pizzas", "Boissons", "Desserts"
  order  Int        @default(0) // display order on the board
  icon   String?    // icon key rendered by the frontend
  color  String?    // hex color or tailwind key
  items  MenuItem[]
  screens Screen[] // TV screens this category is assigned to
}

model MenuItem {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  price       Float?
  imageUrl    String?       // cover image (legacy)
  images      String   @default("[]") // JSON array of image URLs
  tags        String   @default("[]") // JSON array: "spicy", "vegan", "promo"
  status      String   @default("available") // "available" | "out_of_stock" | "archived"
  available   Boolean  @default(true) // legacy, synced with status
  order       Int      @default(0) // display order within category
  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id])
  screens     Screen[] // TV screens this item is assigned to
  zoneItems   ZoneItem[] // placement in layout zones
  createdAt   DateTime @default(now())
}

model User {
  id            Int            @id @default(autoincrement())
  name          String
  email         String         @unique
  password      String
  role          String         @default("admin") // "admin" | "staff"
  refreshTokens RefreshToken[]
  createdAt     DateTime       @default(now())
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique // sha256 hash of the refresh token
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Screen {
  id         Int        @id @default(autoincrement())
  name       String   // e.g. "TV1", "TV Entrée"
  location   String?  // e.g. "Salle principale", "Terrasse"
  layout     String   @default("{\"template\":\"full\"}") // legacy JSON layout config
  status     String   @default("offline") // "online" | "offline" | "disabled"
  lastPing   DateTime @default(now()) // last heartbeat received from the TV
  categories Category[] // categories assigned to this screen
  items      MenuItem[] // individual items assigned to this screen
  screenLayout ScreenLayout? // zone-based layout (T6.x)
  createdAt  DateTime @default(now())
}

model Theme {
  id         Int            @id @default(autoincrement())
  name       String         @unique // e.g. "Défaut Galaxy Food"
  isDefault  Boolean        @default(false) // fallback theme used when a layout has no themeId
  colors     String         @default("{}") // JSON: { primary, secondary, bgDark, bgLight, accent, text }
  fonts      String         @default("{}") // JSON: { heading, body }
  badgeStyle String         @default("torn-paper") // "torn-paper" | "rounded" | "ribbon"
  currency   String         @default("CHF") // symbol printed after every price (CHF, €, DT...)
  layouts    ScreenLayout[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @default(now())
}

model ScreenLayout {
  id        Int      @id @default(autoincrement())
  screenId  Int      @unique // one layout per screen (for now)
  screen    Screen   @relation(fields: [screenId], references: [id], onDelete: Cascade)
  themeId   Int?     // optional — falls back to the default theme
  theme     Theme?   @relation(fields: [themeId], references: [id], onDelete: SetNull)
  name      String?  // optional label, e.g. "Layout principal"
  status    String   @default("draft") // "draft" | "published" — live TV only renders published
  settings  String   @default("{}") // JSON: showPrices, showImages, refreshInterval...
  zones     Zone[]
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@index([screenId])
  @@index([themeId])
}

model Zone {
  id              Int          @id @default(autoincrement())
  layoutId        Int
  layout          ScreenLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  name            String?  // optional label
  zoneType        String   @default("menu") // "menu" | "list" | "carousel" | "banner" | "highlight"
  gridConfig      String   @default("{}") // JSON: { rows, cols } for the zone's inner grid
  cardTemplate    String   @default("default") // "default" | "compact" | "large" | "minimal"
  backgroundStyle String?  // optional JSON/CSS background (color, image)
  badgeConfig     String?  // JSON: { text, price, style, position } — zone badge/label overlay (T7.3)
  x               Int      @default(0) // position on the screen's global grid
  y               Int      @default(0)
  w               Int      @default(1) // width in grid columns
  h               Int      @default(1) // height in grid rows
  order           Int      @default(0) // z-order / render order
  items           ZoneItem[]
  createdAt       DateTime @default(now())

  @@index([layoutId])
}

model ZoneItem {
  id        Int       @id @default(autoincrement())
  zoneId    Int
  zone      Zone      @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  itemId    Int
  item      MenuItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  row       Int?      // row position inside a grid zone
  col       Int?      // column position inside a grid zone
  index     Int?      // sequential position for list/carousel zones
  order     Int       @default(0) // fallback ordering
  qty       Int?      // display multiplier for list-row-price-qty template (e.g. "5X")
  createdAt DateTime  @default(now())

  @@unique([zoneId, itemId])
  @@index([zoneId])
}